# Copy this file to .env and change the values.

DATABASE_URL="file:./dev.db"

# Admin sign-in (the login page asks for both)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"

# A long random string. It signs the admin session cookie. Change it before going live.
AUTH_SECRET="change-this-to-a-long-random-string"

# The public address of the website. Used for search engine links, the sitemap and sharing.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: link for "Website by HK DevLab" in the footer. Leave empty for plain text without a link.
NEXT_PUBLIC_CREDIT_URL=""

# Only on Vercel (production). Vercel fills these in when you add a Postgres database and a Blob store.
# DATABASE_URL="postgres://..."
# DATABASE_URL_UNPOOLED="postgres://..."
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."   (newer Blob stores set BLOB_STORE_ID instead)
